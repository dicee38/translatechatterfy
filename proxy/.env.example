# Скопируй в .env и заполни. .env в .gitignore, реальные ключи сюда не коммитить.

# Секретный токен, который расширение шлёт в заголовке X-Extension-Token.
# Сгенерировать любой случайный: openssl rand -hex 32
EXTENSION_TOKEN=

# Ключи моделей — ВЕЧЕРОМ, когда пополнится баланс. До этого MOCK_MODE=true,
# сервер не запустится с пустыми ключами при MOCK_MODE=false (см. src/config.js).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# true = не ходить в OpenAI/Claude, возвращать фиктивные ответы.
# Держать true, пока не пополнен баланс API (см. CLAUDE.md, чек-лист).
MOCK_MODE=true

# Дневной лимит бюджета в USD. TZ п.3.3: $5/день — стартовое значение,
# предварительное, скорректировать после недели реального использования.
DAILY_BUDGET_USD=5

PORT=8787
